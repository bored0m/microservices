FROM node:20-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
ARG VITE_AUTH_URL
ARG VITE_UTILITY_URL
ARG VITE_BILLING_URL
ARG VITE_NOTIFICATION_URL
ARG VITE_TRANSPORT_URL
ARG VITE_ENVIRONMENT_URL
ENV VITE_AUTH_URL=$VITE_AUTH_URL VITE_UTILITY_URL=$VITE_UTILITY_URL VITE_BILLING_URL=$VITE_BILLING_URL \
    VITE_NOTIFICATION_URL=$VITE_NOTIFICATION_URL VITE_TRANSPORT_URL=$VITE_TRANSPORT_URL VITE_ENVIRONMENT_URL=$VITE_ENVIRONMENT_URL
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
