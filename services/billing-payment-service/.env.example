# Секрет должен совпадать с JWT_SECRET в Identity & Auth Service
BILLING_JWT_SECRET=change-me
BILLING_JWT_ALGORITHM=HS256

# Общий секрет платёжного провайдера (заголовок X-Webhook-Secret)
BILLING_WEBHOOK_SECRET=webhook-secret-change-me

# Адреса соседних сервисов. Сервисы запускаются из разных compose-проектов,
# поэтому по умолчанию обращаемся к ним через хост-машину (подправьте порты под свой запуск).
BILLING_IDENTITY_SERVICE_URL=http://host.docker.internal:8001
BILLING_NOTIFICATION_SERVICE_URL=http://host.docker.internal:8000

# false — не ходить в Identity Service за проверкой существования пользователя
BILLING_VERIFY_USERS=true
